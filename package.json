{
  "name": "mcpskills-center",
  "version": "0.1.0",
  "description": "Unified MCP and skills management, audit, sync, and visualization platform for Claude Code, OpenCode, and Codex",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/**/*.test.js",
