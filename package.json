{
  "name": "mcpskills-center",
  "version": "0.3.0",
  "description": "Unified MCP and skills management, audit, sync, and visualization platform for Claude Code, OpenCode, and Codex",
  "main": "dist/index.js",
  "bin": {
    "mcpskills": "dist/bin.js",
    "mcpskills-center": "dist/bin.js"
  },
  "type": "module",
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x || 25.x || 26.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/quzhiii/mcpskills-center.git"
  },
  "files": [
    "dist/",
    "config/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/**/*.test.js",
    "scan": "node dist/index.js scan",
    "audit": "node dist/index.js audit",
    "sync": "node dist/index.js sync",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "skills",
    "claude",
    "opencode",
    "codex",
    "agent",
    "inventory",
    "audit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
